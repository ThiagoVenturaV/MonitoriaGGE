# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA DE FAILOVER AUTOMÁTICO
# ==============================================================================

# --- APLICAÇÃO & HEALTH CHECK ---
APP_NAME=minha-aplicacao-api
PRIMARY_HEALTH_CHECK_URL=https://api.seudominio.com/health
PRIMARY_SERVER_IP=185.XXX.XXX.XXX # IP Fixo da sua Hostinger KVM 2

# --- CLOUDFLARE ---
CLOUDFLARE_API_TOKEN=seu_cloudflare_api_token_aqui
CLOUDFLARE_ZONE_ID=seu_cloudflare_zone_id_aqui
CLOUDFLARE_DNS_RECORD_ID=seu_cloudflare_dns_record_id_aqui
DOMAIN_NAME=api.seudominio.com

# --- DIGITALOCEAN ---
DIGITALOCEAN_TOKEN=dop_v1_seu_digitalocean_token_aqui
DO_REGION=nyc1                    # Região (ex: nyc1, sfo3, fra1)
DO_SIZE=s-1vcpu-2gb               # Tamanho do Droplet
DO_IMAGE=ubuntu-22-04-x64         # Imagem base
DO_SSH_KEYS=[]                    # Opcional: ID ou Fingerprint da sua chave SSH na DO ex: [1234567]
DO_DROPLET_NAME=fallback-api-droplet

# --- BANCO DE DADOS GERENCIADO (SUPABASE / NEON) ---
DATABASE_URL="postgresql://usuario:senha@seu-db.supabase.co:5432/postgres?sslmode=require"

# --- STORAGE DE MÍDIA (CLOUDFLARE R2 / BACKBLAZE B2) ---
R2_ACCESS_KEY_ID=sua_access_key_r2
R2_SECRET_ACCESS_KEY=sua_secret_key_r2
R2_BUCKET_NAME=meu-bucket-midias
R2_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com

# --- NOTIFICAÇÃO DE ALERTA (DISCORD / TELEGRAM WEBHOOK) ---
NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
